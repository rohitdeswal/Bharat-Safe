PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/bharatsafe

# Telegram emergency-contact delivery. Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# SMTP email backup. For Gmail, use a Google App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_NAME="Bharat Safe"

# Optional public origin for SOS page links sent with alerts.
PUBLIC_BASE_URL=

# Active SOS timeout (milliseconds): 15 minutes normally, 3 minutes in demo timing mode.
SOS_ACTIVE_TIMEOUT_MS=900000
SOS_DEMO_ACTIVE_TIMEOUT_MS=180000
